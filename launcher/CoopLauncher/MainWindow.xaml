<Window x:Class="CoopLauncher.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="SA:COOP Launcher" Width="1280" Height="840" MinWidth="1080" MinHeight="740"
 WindowStartupLocation="CenterScreen" Background="#11171B" Foreground="#F0F2EF" WindowStyle="None" ResizeMode="CanResize">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0"/></shell:WindowChrome.WindowChrome>
 <Border x:Name="Root" BorderBrush="#30393D" BorderThickness="1" Background="#11171B">
  <Grid><Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid Background="#101519"><TextBlock Text="SA:COOP" Margin="23,0" VerticalAlignment="Center" FontWeight="Black" FontSize="16"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
     <Button Content="—" Click="Minimize" Width="45" Padding="0" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Свернуть"/>
     <Button Content="□" Click="Maximize" Width="45" Padding="0" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Развернуть"/>
     <Button Content="✕" Click="CloseWindow" Width="45" Padding="0" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Закрыть"/>
    </StackPanel>
   </Grid>
   <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="185"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#0D1215" BorderBrush="#293236" BorderThickness="0,1,1,0">
     <Grid><Grid.RowDefinitions><RowDefinition Height="135"/><RowDefinition Height="*"/><RowDefinition Height="62"/></Grid.RowDefinitions>
      <StackPanel Margin="22,34,0,0"><TextBlock FontFamily="Arial Black" FontSize="27" FontWeight="Black"><Run Text="SA:"/><Run Text="COOP" Foreground="{StaticResource Green}"/></TextBlock>
       <TextBlock Text="S A N   A N D R E A S" FontSize="9" Margin="3,5,0,0" Foreground="#B5BDBB"/></StackPanel>
      <StackPanel Grid.Row="1">
       <Button x:Name="HomeNav" Style="{StaticResource Nav}" Click="HomeClick"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Green}" FontSize="22" Margin="0,0,14,0"/><TextBlock Text="Главная" FontWeight="SemiBold"/></StackPanel></Button>
       <Button x:Name="InstallNav" Style="{StaticResource Nav}" Click="InstallPageClick"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Muted}" FontSize="22" Margin="0,0,14,0"/><TextBlock Text="Установить игру"/></StackPanel></Button>
       <Button x:Name="UpdatesNav" Style="{StaticResource Nav}" Click="UpdatesClick"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Muted}" FontSize="22" Margin="0,0,14,0"/><TextBlock Text="Обновления"/></StackPanel></Button>
       <Button x:Name="SettingsNav" Style="{StaticResource Nav}" Click="SettingsClick"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Muted}" FontSize="22" Margin="0,0,14,0"/><TextBlock Text="Настройки"/></StackPanel></Button>
      </StackPanel>
      <TextBlock Grid.Row="2" Text="Лаунчер 1.1.0" Foreground="#758389" Margin="23,0" VerticalAlignment="Center" FontSize="12"/>
     </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="22,0,22,18">
     <Grid.RowDefinitions><RowDefinition Height="78"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid><TextBlock x:Name="GreetingText" Text="Привет, игрок" FontSize="29" FontWeight="Bold" VerticalAlignment="Center"/>
      <Border Width="43" Height="43" CornerRadius="22" Background="#2F4F31" BorderBrush="#76B96B" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Center">
       <TextBlock x:Name="AvatarText" Text="M" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
     </Grid>
     <Grid Grid.Row="1">
      <Grid x:Name="HomePage"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="196"/></Grid.RowDefinitions>
       <Border CornerRadius="9" ClipToBounds="True" BorderBrush="#39413E" BorderThickness="1" Margin="0,0,0,15">
        <Grid>
         <Image Source="Assets/hero.png" Stretch="UniformToFill"/>
         <Border><Border.Background><LinearGradientBrush StartPoint="0,1" EndPoint="0.8,0"><GradientStop Color="#E50D1418" Offset="0"/><GradientStop Color="#000D1418" Offset="0.85"/></LinearGradientBrush></Border.Background></Border>
         <StackPanel VerticalAlignment="Bottom" Margin="25,0,0,28">
          <TextBlock Text="SAN ANDREAS" FontFamily="Impact" FontSize="53" Foreground="#FAF5E6"><TextBlock.Effect><DropShadowEffect BlurRadius="3" ShadowDepth="2" Opacity="0.8"/></TextBlock.Effect></TextBlock>
          <TextBlock Text="C O O P E R A T I V E" FontSize="17" FontWeight="Bold" Foreground="{StaticResource Green}" Margin="2,3,0,0"/>
         </StackPanel>
        </Grid>
       </Border>
       <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="#172025" BorderBrush="#2B373C" BorderThickness="1" CornerRadius="8" Padding="22,17">
         <StackPanel><TextBlock x:Name="NotesTitle" Text="Возможности SA:COOP" FontSize="20" FontWeight="Bold"/>
          <TextBlock x:Name="VersionText" Text="Версия —" Foreground="{StaticResource Green}" FontSize="25" FontWeight="Bold" Margin="0,4,0,7"/>
          <TextBlock x:Name="NotesText" Text="• Догонялки и смена ролей&#x0a;• Временная выносливость&#x0a;• Передача оружия и помощь другу" Foreground="#CFD6D5" FontSize="14" LineHeight="24" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="78"/>
         </StackPanel>
        </Border>
        <Border Grid.Column="2" Background="#172025" BorderBrush="#2B373C" BorderThickness="1" CornerRadius="8" Padding="20,18">
         <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal"><TextBlock x:Name="StateIcon" Text="●" Foreground="{StaticResource Green}" FontSize="24" Margin="0,0,12,0"/><TextBlock x:Name="StatusTitle" Text="Готово к запуску" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel>
          <TextBlock Grid.Row="1" x:Name="StatusDetail" Text="Проверьте обновления перед игрой." Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="13" Margin="0,8,0,8"/>
          <Button Grid.Row="2" x:Name="CheckButton" Content="Проверить обновления" Click="CheckClick" Padding="12,10"/>
         </Grid>
        </Border>
       </Grid>
      </Grid>
      <Border x:Name="UpdatesPage" Visibility="Collapsed" Background="#172025" CornerRadius="9" Padding="26">
       <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Обновления" FontSize="28" FontWeight="Bold"/>
        <TextBlock x:Name="SourceText" Grid.Row="1" Text="GitHub Releases · MortysCode/GTASA-COOP" Foreground="{StaticResource Muted}" Margin="0,10,0,22" TextWrapping="Wrap"/>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="ReleaseNotesText" Text="Здесь появится описание опубликованной версии.&#x0a;&#x0a;Лаунчер проверяет архив и делает резервную копию перед заменой файлов SA:COOP." TextWrapping="Wrap" Foreground="#CFD6D5" FontSize="15" LineHeight="25"/></ScrollViewer>
        <WrapPanel Grid.Row="3" Margin="0,20,0,0"><Button x:Name="UpdatesCheckButton" Content="Проверить обновления" Click="CheckClick" Margin="0,0,10,8"/>
         <Button x:Name="LocalArchiveButton" Content="Установить из архива…" Click="LocalArchiveClick" Margin="0,0,10,8"/>
         <Button Content="Открыть Releases ↗" Click="OpenReleases" Margin="0,0,0,8"/></WrapPanel>
       </Grid>
      </Border>
      <Border x:Name="InstallPage" Visibility="Collapsed" Background="#172025" CornerRadius="9" Padding="26">
       <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
        <TextBlock Text="Установить игру" FontSize="28" FontWeight="Bold"/>
        <TextBlock Text="Ваша GTA + готовая сборка SA:COOP" Foreground="{StaticResource Green}" FontSize="19" Margin="0,10,0,10"/>
        <TextBlock Text="Выберите собственную установленную GTA San Andreas 1.0 US. Лаунчер скопирует её в новую папку, скачает моды этой сборки и последнюю версию SA:COOP." Foreground="#CFD6D5" TextWrapping="Wrap" LineHeight="23"/>
        <TextBlock Text="1. Ваша копия GTA San Andreas 1.0 US" Margin="0,24,0,8" Foreground="{StaticResource Muted}"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <TextBox x:Name="InstallSourceInput" IsReadOnly="True" VerticalContentAlignment="Center"/>
         <Button x:Name="InstallSourceButton" Grid.Column="1" Content="Выбрать…" Click="InstallSourceClick" Margin="10,0,0,0"/>
        </Grid>
        <TextBlock Text="2. Новая папка для игры с модами" Margin="0,20,0,8" Foreground="{StaticResource Muted}"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <TextBox x:Name="InstallTargetInput" VerticalContentAlignment="Center"/>
         <Button x:Name="InstallTargetButton" Grid.Column="1" Content="Выбрать…" Click="InstallTargetClick" Margin="10,0,0,0"/>
        </Grid>
        <TextBlock Text="Папка должна быть новой или пустой. Исходная игра и её сохранения остаются на месте." TextWrapping="Wrap" Foreground="#7F8D93" FontSize="12" Margin="0,8,0,15"/>
        <Border Background="#10191D" BorderBrush="#304238" BorderThickness="1" CornerRadius="6" Padding="15">
         <StackPanel><TextBlock Text="Что установится" FontWeight="Bold" FontSize="16"/>
          <TextBlock Text="SA:COOP со всеми командами и догонялками · ModLoader · CLEO · SilentPatch · исправления для 60 FPS · графические моды сборки" TextWrapping="Wrap" Foreground="#CFD6D5" LineHeight="23" Margin="0,7,0,0"/>
          <TextBlock x:Name="InstallInfoText" Text="Пакет модов — около 952 МБ для скачивания и 2 ГБ после распаковки. Дополнительно нужно место для копии вашей GTA и временных файлов." TextWrapping="Wrap" Foreground="{StaticResource Muted}" LineHeight="21" Margin="0,7,0,0"/>
         </StackPanel>
        </Border>
        <Button x:Name="InstallStartButton" Content="Установить игру с SA:COOP" Click="InstallGameClick" HorizontalAlignment="Left" Background="#4D9E48" BorderBrush="#77C86C" Margin="0,20,0,0" Padding="22,14"/>
       </StackPanel></ScrollViewer>
      </Border>
      <Border x:Name="SettingsPage" Visibility="Collapsed" Background="#172025" CornerRadius="9" Padding="26">
       <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
        <TextBlock Text="Настройки" FontSize="28" FontWeight="Bold"/>
        <TextBlock Text="Папка Grand Theft Auto — San Andreas" Margin="0,22,0,8" Foreground="{StaticResource Muted}"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <TextBox x:Name="GamePathInput" IsReadOnly="True" VerticalContentAlignment="Center"/>
         <Button Grid.Column="1" x:Name="BrowseButton" Content="Обзор…" Click="BrowseClick" Margin="10,0,0,0"/>
        </Grid>
        <TextBlock Text="Официальный источник обновлений" Margin="0,22,0,8" Foreground="{StaticResource Muted}"/>
        <Border Background="#0E1418" BorderBrush="#3C494F" BorderThickness="1" Padding="12"><TextBlock Text="github.com/MortysCode/GTASA-COOP"/></Border>
        <TextBlock Text="Источник закреплён в сборке лаунчера и не меняется в настройках." TextWrapping="Wrap" Foreground="#7F8D93" FontSize="12" Margin="0,7,0,15"/>
        <CheckBox x:Name="StartupCheck" Content="Проверять обновления при запуске"/>
        <CheckBox x:Name="MinimizeCheck" Content="Сворачивать лаунчер после запуска GTA"/>
        <WrapPanel Margin="0,23,0,0"><Button x:Name="SaveSettingsButton" Content="Сохранить настройки" Click="SaveSettingsClick" Margin="0,0,10,8"/>
         <Button Content="Резервные копии" Click="OpenBackups" Margin="0,0,0,8"/>
        </WrapPanel>
        <TextBlock Text="Обновление SA:COOP сохраняет ваши сохранения и coop.ini. Для установки GTA с полным набором модов используйте вкладку «Установить игру»." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,24,0,0" LineHeight="22"/>
       </StackPanel></ScrollViewer>
      </Border>
     </Grid>
     <StackPanel Grid.Row="2" Margin="0,14,0,0">
      <ProgressBar x:Name="Progress" Visibility="Collapsed" Height="4" Foreground="{StaticResource Green}" Background="#283237" Minimum="0" Maximum="100" Margin="0,0,0,9"/>
      <TextBlock x:Name="OperationText" Visibility="Collapsed" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap"/>
      <Button x:Name="CancelInstallButton" Content="Отменить установку" Click="CancelInstallClick" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,0,0,8" Padding="12,7"/>
      <Border Background="#141C21" BorderBrush="#2B373C" BorderThickness="1" CornerRadius="8" Padding="18,13">
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Margin="0,0,10,0"><TextBlock Text="Grand Theft Auto — San Andreas" FontWeight="Bold" FontSize="16"/>
         <TextBlock x:Name="FolderText" Text="Папка игры не выбрана" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
        <Button Grid.Column="1" x:Name="PrimaryButton" Click="PrimaryClick" Background="#4D9E48" BorderBrush="#77C86C" Padding="18,14">
         <TextBlock x:Name="PrimaryLabel" Text="▶  ИГРАТЬ" FontSize="23" FontWeight="Bold" Foreground="White"/>
        </Button>
        <Button Grid.Column="2" Click="SettingsClick" Margin="10,0,0,0" Padding="0" AutomationProperties.Name="Настройки"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="22"/></Button>
       </Grid>
      </Border>
     </StackPanel>
    </Grid>
   </Grid>
  </Grid>
 </Border>
</Window>
